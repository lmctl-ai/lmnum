# Robertson chemical kinetics: rate constants span nine orders of magnitude, so the solution lives on time scales from
# microseconds to days. CVODE's BDF method integrates it decade by decade; the plot is logarithmic in time.
# lmnum computes, lmplot draws docs/images/stiff_kinetics.png.
mkdir("images");
mkdir("data");
sim = _dsl_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let y0 = 1.0;
let y1 = 0.0;
let y2 = 0.0;
let all = num.parse("0.0000001 1.0 0.0 0.0");      # start the table at t = 1e-7
let t = 0.0000001;
for (k in range(0, 12)) {
  let sys = num.ode(3).stiff();
  sys.rhs(0, "-0.04*y0 + 10000*y1*y2");
  sys.rhs(1, "0.04*y0 - 10000*y1*y2 - 30000000*y1*y1");
  sys.rhs(2, "30000000*y1*y1");
  sys.init(0, y0).init(1, y1).init(2, y2);
  sys.tol(0.000000001, 0.00000000000001);
  let t_end = t * 10.0;
  let seg = sys.solve(0.0, t_end - t, 26);          # restarted from the previous state; times are relative
  # shift times to absolute and drop the repeated first row
  for (i in range(1, 26)) {
    let row = seg.row(i);
    let abs_row = num.matrix(1, 4);
    abs_row.set(0, 0, t + row.get(0, 0));
    abs_row.set(0, 1, row.get(0, 1)).set(0, 2, row.get(0, 2)).set(0, 3, row.get(0, 3));
    all = all.vstack(abs_row);
  }
  let last = seg.row(25);
  y0 = last.get(0, 1);
  y1 = last.get(0, 2);
  y2 = last.get(0, 3);
  t = t_end;
}
all.save_csv("data/robertson.csv");
# mass is conserved: y0 + y1 + y2 = 1 at the end of the twelve decades (the table is uniform within each decade)
num.assert_close(y0 + y1 + y2, 1.0, 0.000001);
num.print("final state at t=" + str(t) + ": " + str(y0) + " " + str(y1) + " " + str(y2));
end _dsl_
savedsl(sim, "data/stiff_kinetics-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/stiff_kinetics-sim.dslb;
assert(r.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/stiff_kinetics.png", 900, 560);
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'");
plot.cmd("set title 'Robertson kinetics: A -> B -> C over twelve decades of time (stiff, BDF)'");
plot.cmd("set logscale x; set format x '10^{%L}'; set xtics 1e-6,100; set xlabel 'time'; set ylabel 'concentration'; set key center left box opaque");
plot.cmd("set xrange [1e-7:1e5]; set yrange [0:1.05]");
plot.cmd("plot 'data/robertson.csv' u 1:2 w l lw 3 lc rgb '#1f77b4' t 'A (y0)', '' u 1:($3*10000.0) w l lw 3 lc rgb '#d62728' t 'B x 10^4', '' u 1:4 w l lw 3 lc rgb '#2ca02c' t 'C (y2)'");
plot.close();
end _dsl_
savedsl(draw, "data/stiff_kinetics-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/stiff_kinetics-draw.dslb;
assert(r.code == 0);
println("wrote images/stiff_kinetics.png");
