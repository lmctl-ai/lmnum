# The nonlinear pendulum theta'' = -sin(theta). Small swings take the textbook period T0 = 2 pi (units where
# g/L = 1); large swings take longer, T/T0 = (2/pi) K(sin(theta0/2)) with K the complete elliptic integral,
# which lmnum evaluates with `integrate`. CVODE integrates swings of 10..170 degrees, the period is read off the
# first zero crossing, and the ratio is checked against the elliptic integral (1.18034 at 90 degrees, to 1e-3).
# The phase portrait shows closed orbits inside the separatrix omega = 2 cos(theta/2) and a rotating orbit outside.
# lmplot draws images/pendulum.png.
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let pi = 3.141592653589793;
fn exact_ratio(deg: float) -> float {
  let k = sin(deg * 3.141592653589793 / 360.0);
  return (2.0 / 3.141592653589793) * num.integrate("1/sqrt(1 - " + str(k * k) + "*sin(p)^2)", "p", 0.0, 1.5707963267948966);
}
let table = num.matrix(17, 3);                                # amplitude, numeric ratio, exact ratio
let worst = 0.0;
for (j in range(0, 17)) {
  let deg = 10.0 + 10.0 * float(j);
  let sys = num.ode(2).rhs(0, "y1").rhs(1, "-sin(y0)").init(0, deg * pi / 180.0).init(1, 0.0);
  sys.tol(0.0000000001, 0.000000000001);
  let sol = sys.solve(0.0, 20.0, 4001);                       # the period at 170 degrees is 18.6
  # quarter period: first time theta crosses zero (linear interpolation between samples)
  let tq = -1.0;
  for (i in range(1, 4001)) {
    if (tq < 0.0) {
      if (sol.get(i, 1) <= 0.0) {
        let t0 = sol.get(i - 1, 0);
        let th0 = sol.get(i - 1, 1);
        let th1 = sol.get(i, 1);
        tq = t0 + (sol.get(i, 0) - t0) * th0 / (th0 - th1);
      }
    }
  }
  let ratio = 4.0 * tq / (2.0 * pi);
  let exact = exact_ratio(deg);
  table.set(j, 0, deg).set(j, 1, ratio).set(j, 2, exact);
  worst = max(worst, abs(ratio - exact));
}
num.print("largest |numeric - elliptic| period ratio: " + str(worst));
num.assert_close(worst, 0.0, 0.001);
num.assert_close(exact_ratio(90.0), 1.18034, 0.00001);        # (2/pi) K(1/sqrt 2)
num.assert_close(table.get(16, 2), 2.4393, 0.001);            # 170 degrees: 2.44 times the small-angle period
table.save_csv("data/pendulum_period.csv");
# phase portrait: swings of 30, 90, 150 and 179 degrees, and a rotation with omega0 = 2.2 (above the separatrix 2.0)
let phase = num.matrix(1201, 10);
for (c in range(0, 5)) {
  let th = 0.0;
  let om = 0.0;
  if (c == 0) { th = 30.0 * pi / 180.0; }
  if (c == 1) { th = 90.0 * pi / 180.0; }
  if (c == 2) { th = 150.0 * pi / 180.0; }
  if (c == 3) { th = 179.0 * pi / 180.0; }
  if (c == 4) { om = 2.2; }
  let sys = num.ode(2).rhs(0, "y1").rhs(1, "-sin(y0)").init(0, th).init(1, om);
  let sol = sys.solve(0.0, 24.0, 1201);
  for (i in range(0, 1201)) {
    let angle = sol.get(i, 1);
    if (c == 4) { angle = angle - 2.0 * pi * floor((angle + pi) / (2.0 * pi)); }   # wrap the rotation into [-pi, pi)
    phase.set(i, 2 * c, angle).set(i, 2 * c + 1, sol.get(i, 2));
  }
}
phase.save_csv("data/pendulum_phase.csv");
end _lmcode_
savedsl(sim, "data/pendulum-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode data/pendulum-sim.dslb;
if (r.code != 0) { println(r.stdout); }
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/pendulum.png", 1000, 480);
plot.cmd("set multiplot layout 1,2 title 'Nonlinear pendulum (lmnum CVODE): phase portrait and the amplitude-dependent period' font ',13'");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'");
plot.cmd("set xlabel 'angle theta [rad]'; set ylabel 'angular velocity'; set xrange [-pi:pi]; set yrange [-3.5:2.6]");
plot.cmd("set xtics ('-pi' -pi, '-pi/2' -pi/2, '0' 0, 'pi/2' pi/2, 'pi' pi); set key bottom center horizontal maxrows 2 box opaque font ',8' samplen 1.5");
plot.cmd("set style line 1 lw 2 lc rgb '#1f77b4'; set style line 2 lw 2 lc rgb '#2ca02c'; set style line 3 lw 2 lc rgb '#ff7f0e'; set style line 4 lw 2 lc rgb '#d62728'; set style line 5 lw 2 lc rgb '#9467bd'");
plot.cmd("plot 2*cos(x/2) w l dt 2 lw 1.5 lc rgb '#555555' t 'separatrix', -2*cos(x/2) w l dt 2 lw 1.5 lc rgb '#555555' notitle, 'data/pendulum_phase.csv' u 1:2 w l ls 1 t '30 deg', '' u 3:4 w l ls 2 t '90 deg', '' u 5:6 w l ls 3 t '150 deg', '' u 7:8 w l ls 4 t '179 deg', '' u 9:10 w p pt 7 ps 0.3 lc rgb '#9467bd' t 'rotating (omega0 = 2.2)'");
plot.cmd("set xlabel 'amplitude [degrees]'; set ylabel 'period / small-angle period'; set xrange [0:180]; set yrange [0.95:2.6]; set xtics autofreq; set key top left Left reverse samplen 2 maxrows 2");
plot.cmd("set arrow 1 from 90, 0.95 to 90, 1.18034 nohead dt 3 lc rgb '#888888'; set label 1 '1.1803 at 90 deg' at 92, 1.12 font ',9'");
plot.cmd("plot 'data/pendulum_period.csv' u 1:3 w l lw 2.5 lc rgb '#08519c' t 'elliptic integral', '' u 1:2 w p pt 6 ps 1.4 lw 2 lc rgb '#d62728' t 'CVODE'");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(draw, "data/pendulum-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode data/pendulum-draw.dslb;
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
println("wrote images/pendulum.png");
