# Alpine is pinned by digest so the Linux release toolchain is reproducible.
FROM alpine@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f

RUN apk add --no-cache \
    bash \
    binutils \
    build-base \
    cmake \
    coreutils \
    curl \
    ffmpeg \
    findutils \
    file \
    git \
    ninja \
    nodejs \
    npm \
    python3 \
    tar \
    unzip \
    zip

WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
