# Low-rank image compression with the SVD. A 96 x 96 synthetic picture (a soft disc, a bright ring, diagonal
# stripes and a frame) is factored A = U S V^T by lmnum (`svd_u`, `svd_values`, `svd_v`) and rebuilt from its first
# k singular triplets. Rank 4 already shows the shapes, rank 16 is hard to tell from the original, and the energy
# captured, sum of the first k s_i^2 over the total, is 95% at k = 8 and 99.9% at k = 24 (asserted). Storage: the
# rank-k picture needs k (2 n + 1) numbers instead of n^2. lmplot draws images/svd_compression.png.
# Needs lmnum 0.1.2 (svd_u / svd_v).
mkdir("images");
mkdir("data");
sim = _dsl_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let n = 96;
let img = num.matrix(n, n);
for (i in range(0, n)) {
  for (j in range(0, n)) {
    let x = (float(j) - 47.5) / 48.0;
    let y = (float(i) - 47.5) / 48.0;
    let r = sqrt(x * x + y * y);
    let v = 0.15 + 0.1 * sin(9.0 * (x + y));                        # diagonal stripes
    v = v + 0.8 * max(0.0, 1.0 - r * r / 0.16);                     # soft disc of radius 0.4
    if (r > 0.62) { if (r < 0.72) { v = v + 0.7; } }                 # bright ring
    if (abs(x) > 0.92) { v = 1.0; }                                  # frame
    if (abs(y) > 0.92) { v = 1.0; }
    img.set(i, j, min(v, 1.0));
  }
}
let u = img.svd_u();
let s = img.svd_values();
let v = img.svd_v();
let total = s.transpose().mul(s).get(0, 0);
num.print("largest singular values: " + str(s.get(0, 0)) + " " + str(s.get(1, 0)) + " " + str(s.get(2, 0)));
fn rebuild(u: Matrix, s: Matrix, v: Matrix, k: int) -> Matrix {
  let a = num.matrix(96, 96);
  for (t in range(0, k)) {
    a = a.add(u.col(t).mul(v.col(t).transpose()).scale(s.get(t, 0)));
  }
  return a;
}
let energy = num.matrix(n, 3);                                       # k, energy fraction, relative error of the rank-k picture
let acc = 0.0;
for (k in range(0, n)) {
  acc = acc + s.get(k, 0) * s.get(k, 0);
  energy.set(k, 0, float(k + 1)).set(k, 1, acc / total);
}
for (k in range(0, n)) {
  let rel = 0.0;
  if (k < 40) { rel = rebuild(u, s, v, k + 1).sub(img).norm() / img.norm(); } else { rel = sqrt(max(1.0 - energy.get(k, 1), 0.0)); }
  energy.set(k, 2, max(rel, 0.0000000000000001));
}
num.print("energy captured: k = 8 " + str(energy.get(7, 1)) + ", k = 24 " + str(energy.get(23, 1)));
num.assert_close(min(energy.get(7, 1), 0.95), 0.95, 0.0);            # at least 95% by rank 8
num.assert_close(min(energy.get(23, 1), 0.999), 0.999, 0.0);         # at least 99.9% by rank 24
num.assert_close(rebuild(u, s, v, n).sub(img).norm(), 0.0, 0.000000001);      # full rank rebuilds the picture exactly
num.assert_close(energy.get(3, 2), sqrt(1.0 - energy.get(3, 1)), 0.000000001);   # Eckart-Young: error^2 = dropped energy
energy.save_csv("data/svd_energy.csv");
img.save_csv("data/svd_full.csv");
rebuild(u, s, v, 1).save_csv("data/svd_k1.csv");
rebuild(u, s, v, 4).save_csv("data/svd_k4.csv");
rebuild(u, s, v, 16).save_csv("data/svd_k16.csv");
end _dsl_
savedsl(sim, "data/svd_compression-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/svd_compression-sim.dslb;
if (r.code != 0) { println(r.stdout); }
assert(r.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/svd_compression.png", 1000, 640);
plot.cmd("set multiplot title 'SVD image compression (lmnum): rank-k reconstructions of a 96 x 96 picture' font ',13'");
plot.cmd("set size 0.25, 0.5; set origin 0, 0.44");
plot.cmd("set size ratio -1; unset key; unset colorbox; unset xtics; unset ytics; set border 0; set cbrange [0:1]");
plot.cmd("set palette gray; set xrange [-0.5:95.5]; set yrange [95.5:-0.5]");
plot.cmd("set title 'rank 1 (193 numbers)' font ',10'; plot 'data/svd_k1.csv' matrix w image");
plot.cmd("set origin 0.25, 0.44; set title 'rank 4 (772 numbers)' font ',10'; plot 'data/svd_k4.csv' matrix w image");
plot.cmd("set origin 0.5, 0.44; set title 'rank 16 (3088 numbers)' font ',10'; plot 'data/svd_k16.csv' matrix w image");
plot.cmd("set origin 0.75, 0.44; set title 'original (9216 numbers)' font ',10'; plot 'data/svd_full.csv' matrix w image");
plot.cmd("set size 0.9, 0.44; set origin 0.05, 0; set size noratio; set border 3; set xtics nomirror; set ytics nomirror; set grid lc rgb '#dddddd'; set key center right box opaque font ',9' samplen 1.5");
plot.cmd("set title 'energy captured by the first k singular values (left axis) and relative error of the rank-k picture (right axis, log)' font ',10'; set xlabel 'rank k'; set ylabel 'energy fraction'; set xrange [1:40]; set yrange [0.5:1.01]");
plot.cmd("set arrow 1 from 8, 0.5 to 8, 0.95 nohead dt 2 lc rgb '#888888'; set label 1 '95% at k = 8' at 8.5, 0.62 font ',9'; set arrow 2 from 24, 0.5 to 24, 0.999 nohead dt 2 lc rgb '#888888'; set label 2 '99.9% at k = 24' at 24.5, 0.62 font ',9'");
plot.cmd("set y2label 'relative error'; set logscale y2; set y2range [1e-3:1]; set y2tics; set format y2 '10^{%L}'");
plot.cmd("plot 'data/svd_energy.csv' u 1:2 w lp pt 7 ps 0.6 lc rgb '#1f77b4' t 'energy', '' u 1:3 axes x1y2 w lp pt 5 ps 0.6 lc rgb '#d62728' t 'error'");
plot.cmd("unset multiplot");
plot.close();
end _dsl_
savedsl(draw, "data/svd_compression-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/svd_compression-draw.dslb;
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
println("wrote images/svd_compression.png");
