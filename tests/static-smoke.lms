# Small runtime-only fixture for the release static-link smoke test.
# It writes no result files; every value is checked in the host process.
out = ARGV.len() > 0 ? ARGV[0] : "build/static-smoke.dslb";
p = _dsl_ cli="lmnum";

# A 2x2 solve exercises Eigen's matrix path in the release binary.
let a = num.parse("4 1; 1 3");
let x = a.solve(num.parse("6; 7"));
num.assert_close(x.get(0, 0), 1.0, 0.000000000001);
num.assert_close(x.get(1, 0), 2.0, 0.000000000001);

# CVODE's stiff-capable path, compared with exp(-0.25 * 10).
let decay = num.ode(1).param("k", 0.25).rhs(0, "-k*y0").init(0, 1.0).stiff();
let result = decay.solve(0.0, 10.0, 2);
num.assert_close(result.get(1, 1), 0.0820849986238988, 0.0000001);
end _dsl_
savedsl(p, out);
