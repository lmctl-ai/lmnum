# Normal modes of a chain of 24 equal masses joined by springs and fixed at both ends: the stiffness matrix K is tridiagonal
# (2 on the diagonal, -1 beside it) and its eigenvalues are the squared mode frequencies, lambda_k = 2 - 2 cos(k pi / 25) =
# 4 sin^2(k pi / 50), with eigenvectors sin(j k pi / 25). lmnum's symmetric eigen-solver (Eigen) finds all 24 pairs; the
# script asserts every eigenvalue against the closed form to 1e-10 and the first mode shape against a sine.
# Left: the dispersion curve (numerical dots on the exact curve); right: the first four mode shapes.
# Output: images/vibration_modes.png   (run: lmctl autorun <raw url of this file>)
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let n = 24;
let k = num.matrix(n, n);
for (i in range(0, n)) {
  k.set(i, i, 2.0);
  if (i > 0) { k.set(i, i - 1, -1.0); }
  if (i < n - 1) { k.set(i, i + 1, -1.0); }
}
let ev = k.eig_sym();
let vec = k.eigvec_sym();
for (m in range(0, n)) {
  let exact = 2.0 - 2.0 * cos(float(m + 1) * 3.141592653589793 / 25.0);
  num.assert_close(ev.get(m, 0), exact, 0.0000000001);
  num.print(str(m + 1) + " " + str(ev.get(m, 0)) + " " + str(exact));
}
let sign = 1.0;
if (vec.get(0, 0) < 0.0) { sign = -1.0; }
let scale = sign * vec.get(11, 0) / sin(12.0 * 3.141592653589793 / 25.0);
for (j in range(0, n)) { num.assert_close(sign * vec.get(j, 0), scale * sin(float(j + 1) * 3.141592653589793 / 25.0), 0.000000001); }
vec.col(0).hstack(vec.col(1)).hstack(vec.col(2)).hstack(vec.col(3)).save_csv("data/modes.csv");
end _lmcode_
savedsl(sim, "data/vibration_modes-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode data/vibration_modes-sim.dslb;
if (r.code != 0) { println(r.stdout); }
assert(r.code == 0);
write_file("data/modes_spectrum.txt", r.stdout);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/vibration_modes.png", 1100, 480);
plot.cmd("set multiplot layout 1,2");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'");
plot.cmd("set title 'Dispersion: squared frequency of each mode'");
plot.cmd("set xlabel 'mode number k'; set ylabel 'eigenvalue (squared frequency)'; set xrange [0:25]; set key top left box opaque");
plot.cmd("plot 2-2*cos(x*pi/25) w l lw 4 lc rgb '#bbbbbb' t '2 - 2 cos(k pi / 25)', 'data/modes_spectrum.txt' every ::0::23 u 1:2 w p pt 7 ps 1.5 lc rgb '#d62728' t 'lmnum eigenvalues'");
plot.cmd("set title 'The four lowest mode shapes'");
plot.cmd("set xlabel 'mass index'; set ylabel 'displacement (unit vectors)'; set xrange [1:24]; set key outside right box");
plot.cmd("plot 'data/modes.csv' u ($0+1):1 w lp lw 2 pt 7 lc rgb '#1f77b4' t 'mode 1', '' u ($0+1):2 w lp lw 2 pt 7 lc rgb '#2ca02c' t 'mode 2', '' u ($0+1):3 w lp lw 2 pt 7 lc rgb '#ff7f0e' t 'mode 3', '' u ($0+1):4 w lp lw 2 pt 7 lc rgb '#d62728' t 'mode 4'");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(draw, "data/vibration_modes-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode data/vibration_modes-draw.dslb;
assert(r.code == 0);
println("wrote images/vibration_modes.png");
