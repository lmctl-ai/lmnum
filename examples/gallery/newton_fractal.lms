# Newton's method for z^3 = 1: the plane splits into three basins, one per cube root of unity, with a fractal boundary.
# Colour = which root the iteration reaches, brightness = how fast. The grid is computed in lmscript loops by lmnum
# (complex arithmetic written out by hand); lmplot draws docs/images/newton_fractal.png.
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let n = 400;
let img = num.matrix(n, n);
let hits = 0;
for (i in range(0, n)) {
  for (j in range(0, n)) {
    let x = -1.6 + 3.2 * float(j) / float(n - 1);
    let y = -1.6 + 3.2 * float(i) / float(n - 1);
    let root = 0;
    let steps = 0;
    let going = true;
    while (going) {
      # z <- z - (z^3 - 1) / (3 z^2) = (2 z^3 + 1) / (3 z^2)
      let x2 = x * x - y * y;
      let y2 = 2.0 * x * y;
      let x3 = x2 * x - y2 * y;
      let y3 = x2 * y + y2 * x;
      let nr = 2.0 * x3 + 1.0;
      let ni = 2.0 * y3;
      let dr = 3.0 * x2;
      let di = 3.0 * y2;
      let den = dr * dr + di * di;
      if (den < 0.000000000001) { going = false; }
      if (den >= 0.000000000001) {
        x = (nr * dr + ni * di) / den;
        y = (ni * dr - nr * di) / den;
        steps = steps + 1;
        if (steps >= 40) { going = false; }
        # converged to 1, exp(2 pi i / 3) or exp(-2 pi i / 3)
        if ((x - 1.0) * (x - 1.0) + y * y < 0.000001) { root = 1; going = false; }
        if ((x + 0.5) * (x + 0.5) + (y - 0.8660254037844386) * (y - 0.8660254037844386) < 0.000001) { root = 2; going = false; }
        if ((x + 0.5) * (x + 0.5) + (y + 0.8660254037844386) * (y + 0.8660254037844386) < 0.000001) { root = 3; going = false; }
      }
    }
    # value = root index + brightness in (0, 1): few steps = bright
    let v = 0.0;
    if (root > 0) {
      v = float(root) + 1.0 - min(float(steps), 20.0) / 21.0;
      hits = hits + 1;
    }
    img.set(i, j, v);
  }
}
img.save_csv("data/newton.csv");
# nearly every starting point converges (points that land on the basin boundaries may not within 40 steps)
num.assert_close(float(hits) / float(n * n), 1.0, 0.02);
# the center of the real axis between the roots, z = 2 on the real axis converges to 1: check one pixel on the right edge
num.assert_close(floor(img.get(n / 2, n - 1)), 1.0, 0.0);
end _lmcode_
savedsl(sim, "data/newton_fractal-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/newton_fractal-sim.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/newton_fractal.png", 800, 800);
plot.cmd("set size square; unset key; unset colorbox; set tics out; set border 15");
plot.cmd("set title \"Newton's method for z^3 = 1: basins of attraction\"");
plot.cmd("set xlabel 'Re z'; set ylabel 'Im z'");
plot.cmd("set xrange [-1.6:1.6]; set yrange [-1.6:1.6]");
plot.cmd("set palette defined (0 '#101030', 0.999 '#101030', 1.0 '#08306b', 1.5 '#4292c6', 2.0 '#c6dbef', 2.0001 '#7f0000', 2.5 '#e34a33', 3.0 '#fdd49e', 3.0001 '#00441b', 3.5 '#41ab5d', 4.0 '#d9f0d3')");
plot.cmd("set cbrange [0:4]");
plot.cmd("plot 'data/newton.csv' matrix u (-1.6 + 3.2*$1/399.0):(-1.6 + 3.2*$2/399.0):3 with image");
plot.close();
end _lmcode_
savedsl(draw, "data/newton_fractal-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/newton_fractal-draw.dslb;
assert(r.code == 0);
println("wrote images/newton_fractal.png");
