# Burgers' equation u_t + u u_x = nu u_xx on [-1, 1] from u = -sin(pi x): the faster fluid overtakes the slower and a
# shock forms at x = 0 near t = 1/pi, held to a finite thickness by the viscosity nu = 0.01/pi (the Basdevant et al.
# benchmark). 399 interior points by the method of lines, central differences, CVODE BDF (stiff). Before the shock
# the inviscid solution follows characteristics, u = -sin(pi (x - u t)), which the script solves with Brent's `root`
# at t = 0.1 and compares to the numerics (max error 5e-3, the viscosity already acting on the steepening front). At t = 1.6/pi the slope at the origin reaches the
# benchmark's -152 (to 5%). lmplot draws images/burgers.png: snapshots and the steepening slope.
mkdir("images");
mkdir("data");
sim = _dsl_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let pi = 3.141592653589793;
let m = 399;
let h = 2.0 / 400.0;
let nu = 0.01 / pi;
let sys = num.ode(m).stiff();
sys.param("a", 1.0 / (2.0 * h)).param("d", nu / (h * h));
for (i in range(0, m)) {
  let left = "0";
  let right = "0";
  if (i > 0) { left = "y" + str(i - 1); }
  if (i < m - 1) { right = "y" + str(i + 1); }
  let me = "y" + str(i);
  sys.rhs(i, "-" + me + "*a*(" + right + " - " + left + ") + d*(" + left + " - 2*" + me + " + " + right + ")");
  sys.init(i, -sin(pi * (-1.0 + float(i + 1) * h)));
}
sys.tol(0.00000001, 0.0000000001);
let tmax = 1.6 / pi;
let steps = 65;
let sol = sys.solve(0.0, tmax, steps);
# slope at the origin (point i = 199 is x = 0) at every time, and the snapshots
let slope = num.matrix(steps, 2);
for (k in range(0, steps)) {
  slope.set(k, 0, sol.get(k, 0)).set(k, 1, (sol.get(k, 201) - sol.get(k, 199)) / (2.0 * h));
}
num.print("slope at x = 0 and t = 1.6/pi: " + str(slope.get(steps - 1, 1)) + " (Basdevant: -152.0)");
num.assert_close(slope.get(steps - 1, 1), -152.0, 7.6);
slope.save_csv("data/burgers_slope.csv");
let snaps = num.matrix(m + 2, 6);                       # x, u at t = 0, 0.1, 0.25, 0.4, 1.6/pi
for (i in range(0, m + 2)) {
  snaps.set(i, 0, -1.0 + float(i) * h);
  for (q in range(0, 5)) {
    let t = 0.0;
    if (q == 1) { t = 0.1; }
    if (q == 2) { t = 0.25; }
    if (q == 3) { t = 0.4; }
    if (q == 4) { t = tmax; }
    let u = 0.0;
    if (i > 0) { if (i < m + 1) { u = num.interp(sol.col(0), sol.col(i), t); } }   # interpolate in time between outputs
    snaps.set(i, 1 + q, u);
  }
}
snaps.save_csv("data/burgers_snaps.csv");
# inviscid characteristics at t = 0.1: u solves u + sin(pi (x - u t)) = 0 (unique before breaking at t = 1/pi)
let worst = 0.0;
for (j in range(0, 39)) {
  let x = -0.95 + 0.05 * float(j);
  let exact = num.root("u + sin(" + str(pi) + "*(" + str(x) + " - u*0.1))", "u", -1.0, 1.0);
  let i = 10 * j + 10;                                   # grid index of x (h = 1/200)
  worst = max(worst, abs(snaps.get(i, 2) - exact));
}
num.print("max |numerical - characteristics| at t = 0.1: " + str(worst));
num.assert_close(worst, 0.0, 0.005);
end _dsl_
savedsl(sim, "data/burgers-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/burgers-sim.dslb;
if (r.code != 0) { println(r.stdout); }
assert(r.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/burgers.png", 1000, 480);
plot.cmd("set multiplot layout 1,2 title 'Burgers equation u_t + u u_x = nu u_xx (lmnum CVODE BDF): a shock forms at x = 0' font ',13' noenhanced");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'; set xlabel 'x'; set ylabel 'u'; set xrange [-1:1]; set yrange [-1.1:1.1]");
plot.cmd("set key top right box opaque font ',9' samplen 1.5");
plot.cmd("plot 'data/burgers_snaps.csv' u 1:2 w l lw 2 lc rgb '#bbbbbb' t 't = 0', '' u 1:3 w l lw 2 lc rgb '#1f77b4' t 't = 0.1', '' u 1:4 w l lw 2 lc rgb '#2ca02c' t 't = 0.25', '' u 1:5 w l lw 2 lc rgb '#ff7f0e' t 't = 0.4', '' u 1:6 w l lw 2 lc rgb '#d62728' t 't = 1.6/pi = 0.51'");
plot.cmd("set xlabel 't'; set ylabel 'slope at x = 0'; set xrange [0:0.52]; set yrange [-170:0]; set key bottom left");
plot.cmd("set arrow 1 from 1/pi, -170 to 1/pi, 0 nohead dt 2 lc rgb '#888888'; set label 1 'inviscid breaking time 1/pi' at 1/pi + 0.01, -20 font ',9'");
plot.cmd("set label 2 'Basdevant: -152.0' at 0.3, -160 font ',9' tc rgb '#d62728'");
plot.cmd("plot -152.00516 w l dt 2 lc rgb '#d62728' notitle, 'data/burgers_slope.csv' u 1:2 w l lw 2.5 lc rgb '#08519c' t 'du/dx (0, t)'");
plot.cmd("unset multiplot");
plot.close();
end _dsl_
savedsl(draw, "data/burgers-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/burgers-draw.dslb;
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
println("wrote images/burgers.png");
