# Least squares with confidence bands. Forty noisy points from y = 2 + 0.5 x are fitted by lmnum's `lstsq`
# (QR/SVD on the design matrix [1 x]); the residual variance gives the standard errors of the coefficients, a
# 95% confidence band for the mean line (narrow, waisted at the mean of x) and a 95% prediction band for new
# points (wide). The script asserts that the true line lies inside three standard errors, that `polyfit` gives
# the same coefficients, and that about 95% of the points fall inside the prediction band. lmplot draws
# images/linear_regression.png (fit and bands on top, residuals below).
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let n = 40;
let x = num.linspace(0.0, 10.0, n);
let y = x.scale(0.5).shift(2.0).add(num.normal(n, 1, 7).scale(1.2));   # sigma = 1.2
let design = num.matrix(n, 1).shift(1.0).hstack(x);
let beta = design.lstsq(y);
let b0 = beta.get(0, 0);
let b1 = beta.get(1, 0);
let fitted = design.mul(beta);
let resid = y.sub(fitted);
let rss = resid.transpose().mul(resid).get(0, 0);
let s = sqrt(rss / float(n - 2));                                       # residual standard deviation
let xbar = x.mean();
let dx = x.shift(-xbar);
let sxx = dx.transpose().mul(dx).get(0, 0);
let se_b1 = s / sqrt(sxx);
let se_b0 = s * sqrt(1.0 / float(n) + xbar * xbar / sxx);
let dy = y.shift(-y.mean());
let r2 = 1.0 - rss / dy.transpose().mul(dy).get(0, 0);
num.print("intercept " + str(b0) + " (se " + str(se_b0) + "), slope " + str(b1) + " (se " + str(se_b1) + "), s " + str(s) + ", R^2 " + str(r2));
num.assert_close(b1, 0.5, 3.0 * se_b1);
num.assert_close(b0, 2.0, 3.0 * se_b0);
num.assert_close(s, 1.2, 0.4);
let c = num.polyfit(x, y, 1);                                           # same answer by another route
num.assert_close(c.get(0, 0), b0, 0.000000001);
num.assert_close(c.get(1, 0), b1, 0.000000001);
# bands: t(0.975, 38 degrees of freedom) = 2.0244
let tcrit = 2.0244;
let grid = 101;
let bands = num.matrix(grid, 6);                                        # x, fit, ci lo, ci hi, pi lo, pi hi
for (i in range(0, grid)) {
  let xg = -0.5 + 11.0 * float(i) / float(grid - 1);
  let yg = b0 + b1 * xg;
  let lever = 1.0 / float(n) + (xg - xbar) * (xg - xbar) / sxx;
  let ci = tcrit * s * sqrt(lever);
  let pi = tcrit * s * sqrt(1.0 + lever);
  bands.set(i, 0, xg).set(i, 1, yg).set(i, 2, yg - ci).set(i, 3, yg + ci).set(i, 4, yg - pi).set(i, 5, yg + pi);
}
bands.save_csv("data/regression_bands.csv");
# points with their residuals; count how many sit inside the prediction band
let pts = num.matrix(n, 3);
let inside = 0;
for (i in range(0, n)) {
  let xi = x.get(i, 0);
  let lever = 1.0 / float(n) + (xi - xbar) * (xi - xbar) / sxx;
  if (abs(resid.get(i, 0)) <= tcrit * s * sqrt(1.0 + lever)) { inside = inside + 1; }
  pts.set(i, 0, xi).set(i, 1, y.get(i, 0)).set(i, 2, resid.get(i, 0));
}
pts.save_csv("data/regression_points.csv");
num.print("points inside the 95% prediction band: " + str(inside) + " of " + str(n));
num.assert_close(float(inside) / float(n), 0.95, 0.08);
num.matrix(1, 4).set(0, 0, b0).set(0, 1, b1).set(0, 2, s).set(0, 3, r2).save_csv("data/regression_fit.csv");
end _lmcode_
savedsl(sim, "data/linear_regression-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode data/linear_regression-sim.dslb;
if (r.code != 0) { println(r.stdout); }
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/linear_regression.png", 900, 700);
plot.cmd("stats 'data/regression_fit.csv' u 1:2 nooutput; b0 = STATS_min_x; b1 = STATS_min_y");
plot.cmd("stats 'data/regression_fit.csv' u 3:4 nooutput; s = STATS_min_x; r2 = STATS_min_y");
plot.cmd("set multiplot layout 2,1 title 'Least squares: y = 2 + 0.5 x + noise, fitted with lmnum lstsq' font ',13'");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'; set xrange [-0.5:10.5]");
plot.cmd("set size 1, 0.66; set origin 0, 0.32; set bmargin 1; set format x ''");
plot.cmd("set ylabel 'y'; set key top left box opaque font ',9'");
plot.cmd("set label 1 sprintf('fit: y = %.3f + %.3f x,  s = %.2f,  R^2 = %.3f', b0, b1, s, r2) at graph 0.98, 0.08 right front boxed font ',10'");
plot.cmd("plot 'data/regression_bands.csv' u 1:5:6 w filledcurves lc rgb '#ffe8c2' t '95% prediction band (new points)', '' u 1:3:4 w filledcurves lc rgb '#9ecae1' t '95% confidence band (mean line)', '' u 1:2 w l lw 2.5 lc rgb '#08519c' t 'least-squares line', 2 + 0.5*x w l dt 2 lw 1.5 lc rgb '#d62728' t 'true line', 'data/regression_points.csv' u 1:2 w p pt 7 ps 1.0 lc rgb '#333333' t 'data'");
plot.cmd("unset label 1; set size 1, 0.32; set origin 0, 0; set bmargin 3; set tmargin 0.5; set format x '%g'; set xlabel 'x'; set ylabel 'residual'");
plot.cmd("set yrange [-4*s:4*s]; unset key");
plot.cmd("plot (2*s) w l dt 2 lc rgb '#d62728' notitle, (-2*s) w l dt 2 lc rgb '#d62728' notitle, 0 w l lc rgb '#888888' notitle, 'data/regression_points.csv' u 1:3 w impulses lw 1.5 lc rgb '#08519c' notitle, '' u 1:3 w p pt 7 ps 0.8 lc rgb '#08519c' notitle");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(draw, "data/linear_regression-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode data/linear_regression-draw.dslb;
if (r.code != 0) { println(r.stderr); }
assert(r.code == 0);
println("wrote images/linear_regression.png");
