# Least-squares polynomial fits of 15 noisy samples of sin(2 pi x): degree 1 underfits, degree 3 captures the signal,
# degree 9 chases the noise (tiny training error, wild oscillation between the points).
# Noise is seeded (num.normal), so the picture is reproducible. lmnum fits, lmplot draws docs/images/polyfit_overfit.png.
mkdir("images");
mkdir("data");
sim = _dsl_ cli="lmnum" install="github:lmctl-ai/lmnum@latest";
let n = 15;
let x = num.linspace(0.0, 1.0, n);
let truth = x.map(num.func("sin(6.283185307179586*x)", "x"));
let y = truth.add(num.normal(n, 1, 7).scale(0.25));
x.hstack(y).save_csv("data/fit_points.csv");
let curves = num.matrix(201, 5);
for (i in range(0, 201)) {
  let xx = float(i) / 200.0;
  curves.set(i, 0, xx);
  curves.set(i, 1, sin(6.283185307179586 * xx));
}
let rms_line = 0.0;
for (d in range(0, 3)) {
  let deg = 1;
  if (d == 1) { deg = 3; }
  if (d == 2) { deg = 9; }
  let c = num.polyfit(x, y, deg);
  for (i in range(0, 201)) { curves.set(i, 2 + d, num.polyval(c, float(i) / 200.0)); }
  let sse = 0.0;
  for (i in range(0, n)) {
    let e = num.polyval(c, x.get(i, 0)) - y.get(i, 0);
    sse = sse + e * e;
  }
  num.print("degree " + str(deg) + ": training rms error " + str(sqrt(sse / float(n))));
  if (d == 0) { rms_line = sqrt(sse / float(n)); }
  if (d == 2) {
    # more parameters always fit the training points better: degree 9 is closer than the straight line
    let ratio = sqrt(sse / float(n)) / rms_line;
    num.assert_close(min(ratio, 0.4), ratio, 0.0);   # ratio < 0.4
  }
}
curves.save_csv("data/fit_curves.csv");
end _dsl_
savedsl(sim, "data/polyfit_overfit-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/polyfit_overfit-sim.dslb;
assert(r.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/polyfit_overfit.png", 900, 600);
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'");
plot.cmd("set title 'Polynomial fits of 15 noisy points: underfit, good fit, overfit'");
plot.cmd("set xlabel 'x'; set ylabel 'y'; set yrange [-2.2:2.2]; set key bottom left box opaque");
plot.cmd("plot 'data/fit_curves.csv' u 1:2 w l lw 2 dt 2 lc rgb 'black' t 'true sin(2 pi x)', '' u 1:3 w l lw 2.5 lc rgb '#1f77b4' t 'degree 1', '' u 1:4 w l lw 2.5 lc rgb '#2ca02c' t 'degree 3', '' u 1:5 w l lw 2.5 lc rgb '#d62728' t 'degree 9', 'data/fit_points.csv' u 1:2 w p pt 7 ps 1.6 lc rgb '#444444' t 'noisy samples'");
plot.close();
end _dsl_
savedsl(draw, "data/polyfit_overfit-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/polyfit_overfit-draw.dslb;
assert(r.code == 0);
println("wrote images/polyfit_overfit.png");
